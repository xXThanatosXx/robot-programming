<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_remote</name>
  <version>0.0.0</version>
  <description>The arm_remote package</description>
  <maintainer email="faustoandresescobar@gmail.com">Andres Escobar</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>arm_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>rclpy</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>arm_moveit</depend>
  <depend>moveit_configs_utils</depend>
  <depend>python3-flask</depend>
  <depend>controller_manager_msgs</depend>
